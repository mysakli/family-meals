# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=meals,meals.tailXXXX.ts.net,100.x.y.z
# Comma-separated HTTPS origins (Tailscale Serve MagicDNS name)
CSRF_TRUSTED_ORIGINS=https://meals.tailXXXX.ts.net
# Set True when using Tailscale Serve (TLS terminated in front of Gunicorn)
BEHIND_PROXY=True

# Postgres (used by docker-compose + Django)
DB_NAME=meals
DB_USER=meals
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
# Optional override; Compose sets this for the web service automatically
# DATABASE_URL=postgres://meals:change-me@db:5432/meals

# Media: keep S3 if you already use it on Render
USE_S3=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
